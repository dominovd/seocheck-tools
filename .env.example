# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

# ============================================================
# Anthropic (Claude Haiku 4.5 — primary AI model)
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# Upstash Redis (free tier: 10K commands/day)
# Used for:
#   - Per-IP rate limits on AI endpoints
#   - Output caching (24h TTL) to deduplicate identical prompts
#   - Daily global spend tracking
# Create a database at https://console.upstash.com/
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Cloudflare Turnstile (bot protection on AI endpoints)
# Free, no setup beyond getting site key + secret.
# https://dash.cloudflare.com/?to=/:account/turnstile
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================
# AI cost protection — daily budget kill switch
# When daily Anthropic spend exceeds this, AI endpoints return 429
# until next UTC day. Start low, raise as monetization kicks in.
# ============================================================
AI_DAILY_BUDGET_USD=5

# ============================================================
# Site config
# ============================================================
NEXT_PUBLIC_SITE_URL=https://seocheck.tools
